/* Art is separate from Button text and session actions. Scoped to the menu only. */
.menu-backdrop {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    background-image: url("MenuArt/background.png");
    -unity-background-scale-mode: scale-and-crop;
}
.menu-panel {
    width: 440px; max-width: 96%; padding: 24px 44px 28px 28px;
    background-image: url("MenuArt/panel.png");
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0; border-radius: 0;
}
.main-menu .overlay { align-items: flex-start; background-color: rgba(0, 0, 0, 0); }
.main-menu .menu-panel {
    height: 100%; justify-content: center;
    padding-top: 18px; padding-bottom: 24px;
}
.menu-logo {
    height: 190px; flex-shrink: 0;
    background-image: url("MenuArt/logo.png");
    -unity-background-scale-mode: scale-to-fit;
}
.menu-subtitle {
    color: rgb(23, 32, 47); font-size: 17px;
    -unity-text-align: middle-center; letter-spacing: 3px;
    margin-bottom: 16px; flex-shrink: 0;
}
.menu-panel .eyebrow { display: none; }
.menu-panel .title { color: rgb(23, 32, 47); }
.menu-panel .description {
    color: rgb(62, 56, 47); font-size: 15px; margin-bottom: 16px;
}
.menu-panel > Button {
    height: 58px; min-height: 48px; flex-shrink: 0;
    margin: 0 0 7px 0; padding: 0 36px;
    border-width: 0; border-radius: 0;
    color: rgb(23, 32, 47); -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("MenuArt/button-normal.png");
    background-size: 100% 220%;
    background-position: center center;
    background-repeat: no-repeat no-repeat;
    font-size: 17px;
}
.menu-panel > Button:hover, .menu-panel > Button:focus {
    background-image: url("MenuArt/button-selected.png");
    background-color: rgba(0, 0, 0, 0); color: rgb(255, 246, 224);
}
.menu-panel > Button:active { -unity-background-image-tint-color: rgb(220, 199, 170); }
.menu-panel > Button:disabled { opacity: 0.45; }
.menu-panel .controls { color: rgb(78, 65, 48); font-size: 12px; margin-top: 12px; }
